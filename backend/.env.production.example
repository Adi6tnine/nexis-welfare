# AWS Configuration - PRODUCTION
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-aws-account-id

# DynamoDB Tables - PRODUCTION
USERS_TABLE=nexis-users-prod
ELIGIBILITY_RESULTS_TABLE=nexis-eligibility-results-prod
USER_SESSIONS_TABLE=nexis-user-sessions-prod
SCHEMES_TABLE=nexis-schemes-prod
EXPLANATION_CACHE_TABLE=nexis-explanation-cache-prod

# S3 Buckets - PRODUCTION
KNOWLEDGE_BASE_BUCKET=nexis-knowledge-base-prod
SCHEMES_BUCKET=nexis-knowledge-base-prod

# Amazon Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_REGION=us-east-1
MOCK_BEDROCK=false

# Application Settings
LOG_LEVEL=WARN
MAX_CONTEXT_MESSAGES=10
CACHE_TTL_DAYS=7

# Environment
ENVIRONMENT=production
NODE_ENV=production

# LocalStack (disabled in production)
USE_LOCALSTACK=false
