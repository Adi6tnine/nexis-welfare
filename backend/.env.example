# AWS Configuration
# For local development with LocalStack
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000
AWS_ENDPOINT_URL=http://localhost:4566

# For actual AWS (comment out AWS_ENDPOINT_URL for real AWS)
# AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=123456789012

# DynamoDB Configuration
# For local development
DYNAMODB_ENDPOINT=http://localhost:8000
# For LocalStack DynamoDB (alternative)
# DYNAMODB_ENDPOINT=http://localhost:4566

# DynamoDB Tables
USERS_TABLE=nexis-users-dev
ELIGIBILITY_RESULTS_TABLE=nexis-eligibility-results-dev
USER_SESSIONS_TABLE=nexis-user-sessions-dev
SCHEMES_TABLE=nexis-schemes-dev
EXPLANATION_CACHE_TABLE=nexis-explanation-cache-dev

# S3 Buckets (LocalStack for development)
KNOWLEDGE_BASE_BUCKET=nexis-knowledge-base-dev
SCHEMES_BUCKET=nexis-knowledge-base-dev

# Amazon Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_REGION=us-east-1
# For local development, Bedrock calls will be mocked
MOCK_BEDROCK=true

# Application Settings
LOG_LEVEL=DEBUG
MAX_CONTEXT_MESSAGES=10
CACHE_TTL_DAYS=7

# Environment
ENVIRONMENT=development
NODE_ENV=development

# LocalStack Configuration
USE_LOCALSTACK=true
LOCALSTACK_ENDPOINT=http://localhost:4566
