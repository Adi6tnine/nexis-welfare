# AWS Configuration - STAGING
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-aws-account-id

# DynamoDB Tables - STAGING
USERS_TABLE=nexis-users-staging
ELIGIBILITY_RESULTS_TABLE=nexis-eligibility-results-staging
USER_SESSIONS_TABLE=nexis-user-sessions-staging
SCHEMES_TABLE=nexis-schemes-staging
EXPLANATION_CACHE_TABLE=nexis-explanation-cache-staging

# S3 Buckets - STAGING
KNOWLEDGE_BASE_BUCKET=nexis-knowledge-base-staging
SCHEMES_BUCKET=nexis-knowledge-base-staging

# Amazon Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_REGION=us-east-1
MOCK_BEDROCK=false

# Application Settings
LOG_LEVEL=INFO
MAX_CONTEXT_MESSAGES=10
CACHE_TTL_DAYS=7

# Environment
ENVIRONMENT=staging
NODE_ENV=production

# LocalStack (disabled in staging)
USE_LOCALSTACK=false
