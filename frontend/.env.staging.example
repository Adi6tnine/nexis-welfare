# API Configuration - STAGING
VITE_API_BASE_URL=https://api-staging.nexis.example.com/v1
VITE_API_KEY=staging-api-key-from-aws-secrets

# Environment
VITE_ENVIRONMENT=staging

# Feature Flags
VITE_ENABLE_CHAT_ASSISTANT=true
VITE_ENABLE_AI_EXPLANATIONS=true
VITE_ENABLE_OFFLINE_MODE=true

# Analytics
VITE_ANALYTICS_ID=your-staging-analytics-id
VITE_SENTRY_DSN=your-staging-sentry-dsn

# Development Settings (disabled in staging)
VITE_ENABLE_DEBUG_LOGS=false
VITE_MOCK_API_RESPONSES=false
