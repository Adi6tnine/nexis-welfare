# API Configuration - PRODUCTION
VITE_API_BASE_URL=https://api.nexis.gov.in/v1
VITE_API_KEY=production-api-key-from-aws-secrets

# Environment
VITE_ENVIRONMENT=production

# Feature Flags
VITE_ENABLE_CHAT_ASSISTANT=true
VITE_ENABLE_AI_EXPLANATIONS=true
VITE_ENABLE_OFFLINE_MODE=true

# Analytics
VITE_ANALYTICS_ID=your-production-analytics-id
VITE_SENTRY_DSN=your-production-sentry-dsn

# Development Settings (disabled in production)
VITE_ENABLE_DEBUG_LOGS=false
VITE_MOCK_API_RESPONSES=false
