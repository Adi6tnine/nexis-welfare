# API Configuration
# For local development, use LocalStack endpoint
# For dev/staging/prod, use actual API Gateway endpoint
VITE_API_BASE_URL=http://localhost:4566
VITE_API_KEY=dev-api-key-replace-in-production

# Environment (development, staging, production)
VITE_ENVIRONMENT=development

# Feature Flags
VITE_ENABLE_CHAT_ASSISTANT=true
VITE_ENABLE_AI_EXPLANATIONS=true
VITE_ENABLE_OFFLINE_MODE=true

# Analytics (optional)
VITE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Development Settings
VITE_ENABLE_DEBUG_LOGS=true
VITE_MOCK_API_RESPONSES=false
